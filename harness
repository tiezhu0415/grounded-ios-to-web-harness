  reconcile) reconcile "$@" ;;
  behavior-check) behavior_check "$@" ;;
  visual-check) visual_check "$@" ;;
  webshot) webshot "$@" ;;
  compare) compare_visuals "$@" ;;
  check) check_run "$@" ;;
  help|-h|--help) usage ;;
  *) fail "unknown command: $command" ;;
esac
