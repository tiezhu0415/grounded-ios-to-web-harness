#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"

usage() {
  cat <<'EOF'
Usage:
  ./harness prepare --project <project-id> [--run-id <run-id>] [--dry-run]
  ./harness facts-lock --project <project-id> --run-id <run-id> [--revise]
  ./harness context --project <project-id> --run-id <run-id> [--ocr-language <lang>] [--no-ocr]
  ./harness checkpoint --project <project-id> --run-id <run-id> --stage first-pass|repair [--evidence <run-relative-file>]
  ./harness capture --project <project-id> --feature <feature-id> [--run-id <run-id>] [--dry-run]
  ./harness ios-run --project <project-id> --run-id <run-id> [--dry-run]
  ./harness reconcile --project <project-id> --run-id <run-id>
  ./harness behavior-check --project <project-id> --run-id <run-id>
  ./harness visual-check --project <project-id> --run-id <run-id>
  ./harness webshot --project <project-id> --run-id <run-id> --state <state> --url <local-url> --width <px> --height <px> [--scale <n>] [--wait-for <selector>]
  ./harness compare --project <project-id> --run-id <run-id> --state <state> --ios <ios.png> --web <web.png> [--ios-crop x,y,w,h] [--web-crop x,y,w,h] [--threshold 1-255]
  ./harness check   --project <project-id> --run-id <run-id> [--mode mapping|ios|complete|app]
  ./harness help

Examples:
  ./harness prepare --project demo-app
  ./harness facts-lock --project demo-app --run-id 20260818-full-app
  ./harness context --project demo-app --run-id 20260818-full-app
  ./harness checkpoint --project demo-app --run-id 20260818-full-app --stage first-pass
  ./harness ios-run --project demo-app --run-id 20260818-full-app
  ./harness reconcile --project demo-app --run-id 20260818-full-app
  ./harness behavior-check --project demo-app --run-id 20260818-full-app
  ./harness visual-check --project demo-app --run-id 20260818-full-app
  ./harness capture --project demo-app --feature example-feature
  ./harness webshot --project demo-app --run-id 20260818-example-feature --state default --url http://localhost:5173/example --width 402 --height 874 --scale 3
  ./harness compare --project demo-app --run-id 20260818-example-feature --state default --ios ios-default.png --web web-default.png
  ./harness check --project demo-app --run-id 20260818-example-feature --mode mapping
  ./harness check --project demo-app --run-id 20260818-example-feature --mode ios
EOF
}

fail() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

require_slug() {
  local label="$1"
  local value="$2"
  [[ "$value" =~ ^[a-z0-9][a-z0-9-]*$ ]] || fail "$label must use lowercase letters, numbers, and hyphens: $value"
}

require_positive_integer() {
  local label="$1"
  local value="$2"
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || fail "$label must be a positive integer: $value"
}

resolve_run_file() {
  local run_dir="$1"
  local filename="$2"
  [[ "$filename" == "$(basename -- "$filename")" ]] || fail "evidence filename must not contain a path: $filename"
  [[ "$filename" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*\.png$ ]] || fail "evidence must be a PNG filename: $filename"
  [[ -f "$run_dir/$filename" ]] || fail "evidence file not found in run: $filename"
  printf '%s\n' "$run_dir/$filename"
}

find_source_dir() {
  local project="$1"
  local candidate name normalized

  [[ -d "$ROOT/xcode" ]] || return 1
  for candidate in "$ROOT"/xcode/*; do
    [[ -d "$candidate" ]] || continue
    name="$(basename -- "$candidate")"
    normalized="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"
    if [[ "$normalized" == "$project" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

find_free_port() {
  node - <<'NODE'
const net = require('node:net');
const server = net.createServer();
server.unref();
server.on('error', (error) => { throw error; });
server.listen(0, '127.0.0.1', () => {
  const address = server.address();
  if (!address || typeof address === 'string') throw new Error('failed to allocate a local port');
  process.stdout.write(`${address.port}\n`);
  server.close();
});
NODE
}

prepare_app() {
  local project="" run_id="" dry_run="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) [[ $# -ge 2 ]] || fail "--project needs a value"; project="$2"; shift 2 ;;
      --run-id) [[ $# -ge 2 ]] || fail "--run-id needs a value"; run_id="$2"; shift 2 ;;
      --dry-run) dry_run="true"; shift ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown prepare option: $1" ;;
    esac
  done

  [[ -n "$project" ]] || fail "--project is required"
  require_slug "project-id" "$project"

  local source_dir blueprint web_dir
  source_dir="$(find_source_dir "$project")" || fail "source project not found under xcode/: $project"
  blueprint="$ROOT/docs/项目/$project/项目蓝图.md"
  web_dir="$ROOT/webapps/$project"
  [[ -f "$blueprint" ]] || fail "project blueprint not found: docs/项目/$project/项目蓝图.md"

  if [[ -z "$run_id" ]]; then
    run_id="$(date '+%Y%m%d-%H%M%S')-full-app"
  fi
  require_slug "run-id" "$run_id"

  local runs_parent run_dir temp_dir source_rel web_rel
  runs_parent="$ROOT/.runs/$project"
  run_dir="$runs_parent/$run_id"
  temp_dir="$runs_parent/.$run_id.tmp.$$"
  source_rel="${source_dir#"$ROOT/"}"
  web_rel="webapps/$project"
  [[ ! -e "$run_dir" ]] || fail "run already exists: .runs/$project/$run_id"

  if [[ "$dry_run" == "true" ]]; then
    printf 'HARNESS APP READY\nPROJECT=%s\nSOURCE=%s\nWEBAPP=%s\nRUN_DIR=.runs/%s/%s\n' \
      "$project" "$source_rel" "$web_rel" "$project" "$run_id"
    exit 0
  fi

  mkdir -p "$runs_parent"
  [[ ! -e "$temp_dir" ]] || fail "temporary run directory already exists"
  mkdir "$temp_dir"
  trap 'rm -rf -- "$temp_dir"' EXIT

  cat > "$temp_dir/scope.md" <<EOF
# 全项目迁移

| 项目 | 内容 |
| --- | --- |
| 项目 | \`$project\` |
| 源项目 | \`$source_rel\` |
| WebApp | \`$web_rel\` |
| 目标 | 先锁定源码事实和关键视觉集合，再由 Claude 自主实现统一、可操作的 WebApp |
| 完成定义 | 所有 Screen+State 均可打开并通过基础渲染；核心旅程可操作；关键视觉状态已量化；用户获得验证链接 |

不得使用 iOS 截图充当 Web 页面，不得用占位图或测试数据冒充源项目事实。VRT 指标在 v0.x 只用于暴露差异，不是统一硬阈值。React 架构和实现方式由 Claude 自主决定；最多精修两轮，最终仍由用户验收。
EOF

  node "$ROOT/scripts/app_inventory.mjs" \
    "--project=$project" "--source=$source_dir" "--output=$temp_dir/项目覆盖.json" >/dev/null
  node "$ROOT/scripts/visual_matrix.mjs" \
    "--coverage=$temp_dir/项目覆盖.json" "--output=$temp_dir/visual-matrix.json" >/dev/null
  node "$ROOT/scripts/init_behavior_journeys.mjs" \
    "--coverage=$temp_dir/项目覆盖.json" "--output=$temp_dir/behavior-journeys.json" >/dev/null
  node "$ROOT/scripts/init_reconciliation.mjs" \
    "--coverage=$temp_dir/项目覆盖.json" "--matrix=$temp_dir/visual-matrix.json" "--source=$source_dir" >/dev/null
  node "$ROOT/scripts/source_facts.mjs" \
    "--coverage=$temp_dir/项目覆盖.json" "--output=$temp_dir/source-facts.json" >/dev/null
  node "$ROOT/scripts/truth_map.mjs" \
    "--project=$project" "--output=$temp_dir/truth-map.json" >/dev/null
  node "$ROOT/scripts/state_snapshots.mjs" \
    "--coverage=$temp_dir/项目覆盖.json" "--matrix=$temp_dir/visual-matrix.json" \
    "--output=$temp_dir/state-snapshots.json" >/dev/null

  cat > "$temp_dir/result.json" <<EOF
{
  "project": "$project",
  "run_id": "$run_id",
  "scope": "full-app",
  "status": "APP_INVENTORY_PENDING",
  "source": "$source_rel",
  "webapp": "$web_rel",
  "coverage": "项目覆盖.json",
  "behavior_journeys": "behavior-journeys.json",
  "visual_matrix": "visual-matrix.json",
  "source_facts": "source-facts.json",
  "truth_map": "truth-map.json",
  "state_snapshots": "state-snapshots.json",
  "source_facts_status": "UNLOCKED",
  "build_context_status": "PENDING",
  "work_cycle": "work-cycle.json",
  "reconciliation_status": "PENDING",
  "visual_comparisons": []
}
EOF

  cat > "$temp_dir/work-cycle.json" <<EOF
{
  "version": 1,
  "project": "$project",
  "method": "GROUNDED_FIRST_PASS_THEN_BOUNDED_REPAIR",
  "phase": "DISCOVERY",
  "maximum_repair_rounds": 2,
  "first_pass": { "status": "PENDING" },
  "repairs": [],
  "last_checkpoint": null
}
EOF

  mv "$temp_dir" "$run_dir"
  trap - EXIT
  printf 'HARNESS APP RUN CREATED\nPROJECT=%s\nSOURCE=%s\nWEBAPP=%s\nRUN_ID=%s\nRUN_DIR=.runs/%s/%s\nNEXT=Complete source facts and the Critical Visual Set, capture required iOS states, lock facts, then run context before implementation.\n' \
    "$project" "$source_rel" "$web_rel" "$run_id" "$project" "$run_id"
}

build_context() {
  local project="" run_id="" ocr_language="eng" no_ocr="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) [[ $# -ge 2 ]] || fail "--project needs a value"; project="$2"; shift 2 ;;
      --run-id) [[ $# -ge 2 ]] || fail "--run-id needs a value"; run_id="$2"; shift 2 ;;
      --ocr-language) [[ $# -ge 2 ]] || fail "--ocr-language needs a value"; ocr_language="$2"; shift 2 ;;
      --no-ocr) no_ocr="true"; shift ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown context option: $1" ;;
    esac
  done
  [[ -n "$project" && -n "$run_id" ]] || fail "context requires --project and --run-id"
  require_slug "project-id" "$project"
  require_slug "run-id" "$run_id"
  [[ "$ocr_language" =~ ^[A-Za-z0-9_+.-]+$ ]] || fail "invalid OCR language: $ocr_language"
  local run_dir args
  run_dir="$ROOT/.runs/$project/$run_id"
  [[ -d "$run_dir" ]] || fail "run not found: .runs/$project/$run_id"
  args=(
    "--coverage=$run_dir/项目覆盖.json"
    "--facts=$run_dir/source-facts.json"
    "--matrix=$run_dir/visual-matrix.json"
    "--truth-map=$run_dir/truth-map.json"
    "--state-snapshots=$run_dir/state-snapshots.json"
    "--run-dir=$run_dir"
    "--ocr-language=$ocr_language"
  )
  if [[ "$no_ocr" == "true" ]]; then args+=("--no-ocr=true"); fi
  node "$ROOT/scripts/build_context.mjs" "${args[@]}"
  node - "$run_dir/result.json" "$run_dir/work-cycle.json" "$run_dir/context-index.json" <<'NODE'
const fs = require('node:fs');
const [file, cycleFile, contextFile] = process.argv.slice(2);
const result = JSON.parse(fs.readFileSync(file, 'utf8'));
result.build_context_status = 'READY';
result.build_context = 'context-index.json';
result.build_context_generated_at = new Date().toISOString();
const temporary = `${file}.tmp-${process.pid}`;
fs.writeFileSync(temporary, `${JSON.stringify(result, null, 2)}\n`);
fs.renameSync(temporary, file);
const cycle = JSON.parse(fs.readFileSync(cycleFile, 'utf8'));
const context = JSON.parse(fs.readFileSync(contextFile, 'utf8'));
const contextKey = [context.facts_lock_sha256, context.visual_plan_sha256, context.truth_sources_sha256, context.state_snapshots_sha256].join(':');
if (cycle.last_checkpoint?.context_key && cycle.last_checkpoint.context_key !== contextKey) {
  cycle.first_pass = { status: 'PENDING' };
  cycle.repairs = [];
  cycle.last_checkpoint = null;
}
cycle.phase = 'IMPLEMENT';
const cycleTemporary = `${cycleFile}.tmp-${process.pid}`;
fs.writeFileSync(cycleTemporary, `${JSON.stringify(cycle, null, 2)}\n`);
fs.renameSync(cycleTemporary, cycleFile);
NODE
}

checkpoint() {
  local project="" run_id="" stage="" evidence=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) [[ $# -ge 2 ]] || fail "--project needs a value"; project="$2"; shift 2 ;;
      --run-id) [[ $# -ge 2 ]] || fail "--run-id needs a value"; run_id="$2"; shift 2 ;;
      --stage) [[ $# -ge 2 ]] || fail "--stage needs a value"; stage="$2"; shift 2 ;;
      --evidence) [[ $# -ge 2 ]] || fail "--evidence needs a value"; evidence="$2"; shift 2 ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown checkpoint option: $1" ;;
    esac
  done
  [[ -n "$project" && -n "$run_id" && -n "$stage" ]] || fail "checkpoint requires --project, --run-id, and --stage"
  require_slug "project-id" "$project"
  require_slug "run-id" "$run_id"
  [[ "$stage" == "first-pass" || "$stage" == "repair" ]] || fail "--stage must be first-pass or repair"
  if [[ "$stage" == "repair" ]]; then
    [[ -n "$evidence" ]] || fail "repair checkpoint requires --evidence with a current Run failure/report"
    [[ "$evidence" != /* && "$evidence" != *".."* && -f "$ROOT/.runs/$project/$run_id/$evidence" ]] || \
      fail "repair evidence must be an existing safe path inside the current Run: $evidence"
  fi
  local run_dir web_dir
  run_dir="$ROOT/.runs/$project/$run_id"
  web_dir="$ROOT/webapps/$project"
  [[ -f "$run_dir/work-cycle.json" && -f "$run_dir/context-index.json" ]] || fail "run context is not ready; run facts-lock and context first"
  [[ -d "$web_dir" ]] || fail "WebApp not found: webapps/$project"
  node "$ROOT/scripts/build_context.mjs" \
    "--coverage=$run_dir/项目覆盖.json" "--facts=$run_dir/source-facts.json" \
    "--matrix=$run_dir/visual-matrix.json" "--truth-map=$run_dir/truth-map.json" \
    "--state-snapshots=$run_dir/state-snapshots.json" \
    "--run-dir=$run_dir" "--check=true"
  local checkpoint_args=(
    "--cycle=$run_dir/work-cycle.json" "--web=$web_dir" "--context-index=$run_dir/context-index.json"
    "--action=checkpoint" "--stage=$stage"
  )
  if [[ -n "$evidence" ]]; then checkpoint_args+=("--evidence=$evidence"); fi
  node "$ROOT/scripts/work_cycle.mjs" "${checkpoint_args[@]}"
}

facts_lock() {
  local project="" run_id="" revise="false"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project) [[ $# -ge 2 ]] || fail "--project needs a value"; project="$2"; shift 2 ;;
      --run-id) [[ $# -ge 2 ]] || fail "--run-id needs a value"; run_id="$2"; shift 2 ;;
      --revise) revise="true"; shift ;;
      -h|--help) usage; exit 0 ;;
      *) fail "unknown facts-lock option: $1" ;;
    esac
  done
  [[ -n "$project" && -n "$run_id" ]] || fail "facts-lock requires --project and --run-id"
  require_slug "project-id" "$project"
  require_slug "run-id" "$run_id"
  local run_dir coverage_file matrix_file facts_file snapshots_file
  run_dir="$ROOT/.runs/$project/$run_id"
  coverage_file="$run_dir/项目覆盖.json"
  matrix_file="$run_dir/visual-matrix.json"
  facts_file="$run_dir/source-facts.json"
  snapshots_file="$run_dir/state-snapshots.json"
  [[ -f "$coverage_file" && -f "$matrix_file" && -f "$facts_file" && -f "$snapshots_file" ]] || fail "coverage, visual matrix, source facts, or state snapshots is missing"
  local args=("--coverage=$coverage_file" "--matrix=$matrix_file" "--facts=$facts_file" "--snapshots=$snapshots_file")
  if [[ "$revise" == "true" ]]; then args+=("--revise=true"); fi
  node "$ROOT/scripts/lock_source_facts.mjs" "${args[@]}"
  node - "$run_dir/result.json" "$run_dir/source-facts.json" "$run_dir/behavior-journeys.json" <<'NODE'
const fs = require('node:fs');
const [file, factsFile, journeysFile] = process.argv.slice(2);
const result = JSON.parse(fs.readFileSync(file, 'utf8'));
result.source_facts_status = 'LOCKED';
result.source_facts_locked_at = new Date().toISOString();
const temporary = `${file}.tmp-${process.pid}`;
fs.writeFileSync(temporary, `${JSON.stringify(result, null, 2)}\n`);
fs.renameSync(temporary, file);
const facts = JSON.parse(fs.readFileSync(factsFile, 'utf8'));
const journeys = JSON.parse(fs.readFileSync(journeysFile, 'utf8'));
journeys.facts_lock_sha256 = facts.lock.content_sha256;
journeys.state_snapshots_sha256 = facts.lock.state_snapshots_sha256;
const journeysTemporary = `${journeysFile}.tmp-${process.pid}`;
fs.writeFileSync(journeysTemporary, `${JSON.stringify(journeys, null, 2)}\n`);
fs.renameSync(journeysTemporary, journeysFile);
NODE
}

